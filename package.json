{
  "name": "next-commerce-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate": "graphql-codegen",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "debug:api": "NODE_OPTIONS='--inspect' DEBUG='api:*' next dev",
    "debug:graphql": "NODE_OPTIONS='--inspect' DEBUG='graphql:*' GRAPHQL_DEBUG=true next dev",
    "debug:orders": "NODE_OPTIONS='--inspect' DEBUG='orders:*,redux:*' next dev",
    "debug:payment": "NODE_OPTIONS='--inspect' DEBUG='payment:*,mercadopago:*' next dev",
    "debug:full": "NODE_OPTIONS='--inspect=0.0.0.0:9229' DEBUG='*' next dev",
    "dev:logs": "DEBUG='*' next dev",
    "dev:verbose": "DEBUG='*' NODE_ENV=development next dev",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "clean:full": "rm -rf .next && rm -rf node_modules && npm install",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "test:orders": "echo 'Testing orders system...' && npm run dev",
    "test:graphql": "echo 'Testing GraphQL client...' && npm run debug:graphql",
    "test:payment": "echo 'Testing payment system...' && npm run debug:payment"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@mercadopago/sdk-react": "^1.0.1",
    "@radix-ui/react-toast": "^1.2.6",
    "@reduxjs/toolkit": "^1.9.5",
    "@types/node": "20.6.2",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "@urql/core": "^5.1.0",
    "autoprefixer": "10.4.15",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies": "^0.9.1",
    "critters": "^0.0.24",
    "dotenv": "^16.4.7",
    "eslint": "8.49.0",
    "eslint-config-next": "13.4.19",
    "graphql-request": "^7.1.2",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.487.0",
    "mercadopago": "^2.3.0",
    "next": "^15.2.4",
    "postcss": "8.4.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-loading-skeleton": "^3.5.0",
    "react-range-slider-input": "^3.0.7",
    "react-redux": "^8.1.2",
    "react-slider": "^2.0.6",
    "swiper": "^10.2.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.2.2",
    "urql": "^4.2.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/typescript": "^4.1.3",
    "@graphql-codegen/typescript-operations": "^4.4.1",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react-slider": "^1.3.2",
    "graphql": "^16.10.0"
  }
}
